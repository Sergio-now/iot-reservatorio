# Copie este arquivo para ".env" e preencha com seus dados. 
# O ".env" nunca deve ser commitado no git.

# --- InfluxDB ---
INFLUXDB_USER=seu_usuario
INFLUXDB_PASSWORD=senha_forte_banco
INFLUXDB_ORG=sua_organizacao
INFLUXDB_BUCKET=seu_bucket_de_dados
INFLUXDB_TOKEN=cole_seu_token_aqui_depois_de_iniciar_o_influxdb

# --- Grafana ---
GRAFANA_USER=admin
GRAFANA_PASSWORD=senha_forte_grafana
